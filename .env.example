# Supabase project URL — find it in: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key — find it in: Supabase Dashboard > Project Settings > API > Project API Keys > anon/public
VITE_SUPABASE_ANON_KEY=your-anon-key-here
